{
  "name": "backTesting local",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8001",
      "enabled": true,
      "type": "default",
      "description": "The API as published to the host by docker-compose. Use this from your own machine, and from the Postman app."
    },
    {
      "key": "instrument",
      "value": "AAPL",
      "enabled": true,
      "type": "default",
      "description": "Any symbol with stored candles. QQQ is the design's subject; AAPL is smaller and faster for a smoke run."
    },
    {
      "key": "source",
      "value": "yahoo",
      "enabled": true,
      "type": "default",
      "description": "Must hold bars for {{instrument}} at {{timeframe}}."
    },
    {
      "key": "timeframe",
      "value": "D1",
      "enabled": true,
      "type": "default"
    }
  ],
  "_postman_variable_scope": "environment"
}
