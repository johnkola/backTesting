{
  "name": "backTesting docker",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://api:8001",
      "enabled": true,
      "type": "default",
      "description": "The API by its service name on the compose network. Use this when the runner is itself a container on that network, e.g. in CI."
    },
    {
      "key": "instrument",
      "value": "AAPL",
      "enabled": true,
      "type": "default",
      "description": "Any symbol with stored candles. QQQ is the design's subject; AAPL is smaller and faster for a smoke run."
    },
    {
      "key": "source",
      "value": "yahoo",
      "enabled": true,
      "type": "default",
      "description": "Must hold bars for {{instrument}} at {{timeframe}}."
    },
    {
      "key": "timeframe",
      "value": "D1",
      "enabled": true,
      "type": "default"
    }
  ],
  "_postman_variable_scope": "environment"
}
