# Copy to `.env` and fill in. Compose reads it from the repo root with no extra
# flags; every variable below already has a default in docker-compose.yml, so an
# empty or absent file changes nothing. `.env` is gitignored — this repo is
# public, and the pgAdmin login in particular tends to be a personal address.

# pgAdmin web login (the `tools` profile — see README, "Database UI").
# Read ONLY when the account is first created, i.e. on a fresh pgadmin-data
# volume. Changing these later does nothing; use setup.py update-user inside
# the container instead. The password must be at least 6 characters.
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=change-me

# Where the browser reaches the client and the API. Defaults suit a laptop;
# set them when serving the stack from anything other than localhost. Note
# VITE_API_URL is baked into the bundle at build time, so changing it means
# rebuilding the client image, not restarting it.
# CLIENT_URL=http://localhost:3000
# VITE_API_URL=http://localhost:8001

# Maintenance switch for the UI. See README, "Maintenance mode".
# MAINTENANCE=1
# MAINTENANCE_MESSAGE=Back at 14:00 UTC
